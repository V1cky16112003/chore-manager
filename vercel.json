{
    "version": 2,
    "builds": [
        {
            "src": "app.py",
            "use": "@vercel/python"
        },
        {
            "src": "mcp_server.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/mcp(/.*)?",
            "dest": "mcp_server.py"
        },
        {
            "src": "/(.*)",
            "dest": "app.py"
        }
    ]
}